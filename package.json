    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.3",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
